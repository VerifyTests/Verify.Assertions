    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Verify" Version="33.3.2-beta.1" />
    <PackageVersion Include="Verify.XunitV3" Version="33.3.2-beta.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="Verify.NUnit" Version="33.3.2-beta.1" />
    <PackageVersion Include="Argon" Version="0.38.0" />
    <PackageVersion Include="DiffEngine" Version="20.7.0" />
    <PackageVersion Include="EmptyFiles" Version="8.20.0" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.0" />
